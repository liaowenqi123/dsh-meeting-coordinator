{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "manifestVersion": "0.15",
  "id": "io.github.liaowenqi123.dsh-meeting-coordinator",
  "name": "dsh-meeting-coordinator",
  "version": "0.1.0",
  "facets": {
    "host": {
      "entry": "dist/host.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "meeting.dsh/v1alpha1",
        "kind": "BriefingBoard"
      }
    ],
    "services": []
  },
  "permissions": [
    {
      "name": "messages.observe",
      "scope": "meeting.coordinator.participant-context",
      "reason": "开会时读取参会会话已完成的轮上下文，作为该成员入场的记忆。默认走 fork（由其自带），fork 不可用时回退为限长摘要注入。不读不会议的会话。"
    }
  ],
  "contributes": {
    "commands": [],
    "panels": []
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/liaowenqi123/dsh-meeting-coordinator.git"
  }
}
