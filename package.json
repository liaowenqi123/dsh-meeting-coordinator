{
  "name": "dsh-meeting-coordinator",
  "version": "0.1.0",
  "description": "DSH 多 Agent「会议室」插件：会籍（会议室）+ fork 上下文入场 + 主持人控场多轮讨论 + 会后各自压缩并回到工作区继续工作。基于 dsh-std 元协议。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-std",
    "community-v0.15",
    "multi-agent",
    "meeting",
    "meeting-coordinator",
    "agent-orchestration",
    "context-isolation",
    "agent-coordination",
    "facets",
    "cordis"
  ],
  "license": "MIT",
  "author": "liaowenqi123",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaowenqi123/dsh-meeting-coordinator.git"
  },
  "homepage": "https://github.com/liaowenqi123/dsh-meeting-coordinator#readme",
  "bugs": {
    "url": "https://github.com/liaowenqi123/dsh-meeting-coordinator/issues"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.22.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./facet": {
      "types": "./dist/facet.d.ts",
      "default": "./dist/facet.js"
    },
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:manifest": "tsx src/bin/check-manifest.ts",
    "probe:composition": "tsx src/bin/probe-composition.ts",
    "demo": "tsx src/bin/demo-briefing-exchange.ts",
    "demo:room": "tsx src/bin/demo-meeting-room.ts",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "verify": "pnpm run typecheck && pnpm run check:manifest && pnpm run test && pnpm run build && pnpm run probe:composition && pnpm run demo:room && pnpm run demo"
  },
  "dependencies": {
    "@dsh-std/composition": "0.1.1-rc.1",
    "@dsh-std/core": "0.1.1-rc.2",
    "@dsh-std/lifecycle": "0.1.1-rc.2",
    "@dsh-std/manifest": "0.1.1-rc.2",
    "@dsh-std/sdk": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
